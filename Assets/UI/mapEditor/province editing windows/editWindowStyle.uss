VisualElement {}

.window {
    padding: 10px;
    background-color: #f0f0f0;
    width: 300px;
    height: 200px;
    position: absolute;
    top: 100px;
    left: 100px;
    border-radius: 5px;
    box-shadow: 0px 0px 15px rgba(0, 0, 0, 0.2);
}

.close-button {
    position: absolute;
    top: 5px;
    right: 5px;
    background-color: red;
    color: white;
}

.save-button {
    margin-top: 10px;
    background-color: green;
    color: white;
}

TextField {
    width: 100%;
    margin-top: 5px;
}

IntegerField {
    width: 100%;
    margin-top: 5px;
}