.color-picker {
    flex-direction: column;
    padding: 10px;
    gap: 10px;
}

.sv-box {
    width: 200px;
    height: 200px;
    background-image: url("sv-gradient.png"); /* 2D saturation/value gradient */
    background-size: cover;
    border: 1px solid #000;
}

.hue-slider {
    width: 200px;
    height: 20px;
    background-image: url("hue-gradient.png"); /* horizontal hue gradient */
    background-size: cover;
    border: 1px solid #000;
}

.color-preview {
    width: 200px;
    height: 50px;
    border: 1px solid black;
    background-color: white;
}
